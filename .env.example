# Is file ko copy karke ".env" naam se save karein aur values apni marzi se badlein

PORT=3000

# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/greenbites?retryWrites=true&w=majority

# Brevo (https://app.brevo.com) se API key generate karein: Settings -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@greenbites.com
BREVO_SENDER_NAME=Green Bites
BREVO_RECEIVER_EMAIL=owner@greenbites.com
